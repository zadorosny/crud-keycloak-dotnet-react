# Copie para .env se precisar apontar para outro host. Os valores abaixo sao os defaults.
VITE_API_URL=http://localhost:5080/api/v1
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=mfacrud
VITE_KEYCLOAK_CLIENT_ID=mfacrud-web

# Endpoint OTLP/HTTP do coletor. Vazio (ou ausente) desliga a telemetria do browser.
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:18890
