# Copie para .env e ajuste os valores. O .env é ignorado pelo git.

# PostgreSQL (usuário compartilhado pelos bancos `mfacrud` e `keycloak`)
POSTGRES_USER=mfacrud
POSTGRES_PASSWORD=change-me

# Keycloak: admin inicial do console (http://localhost:8080)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# Client secret do service account `mfacrud-admin-svc`.
# Injetado no realm na importação via placeholder ${MFACRUD_ADMIN_SVC_SECRET}
# e usado pela API (user-secrets: Keycloak:AdminClientSecret) a partir do M3.
MFACRUD_ADMIN_SVC_SECRET=change-me
