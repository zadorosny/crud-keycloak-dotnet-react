                  ],
                  "path": [
                    "realms",
                    "{{realm}}",
                    "protocol",
                    "openid-connect",
                    "token"
                  ]
                },
                "description": "Sem o segundo fator o Keycloak nao emite token.\n\nA especificacao original falava em 401; o Keycloak 26.7.3 responde 400 com `invalid_grant`.\nO teste aceita os dois codigos e checa o que importa: nenhum access_token."
              }
            },
            {
              "name": "Token (customer2fa)",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "// Gera o TOTP do mesmo jeito que o Keycloak: a chave HMAC sao os bytes UTF-8 do secret",
                      "// (o QR code mostra o Base32 desses bytes).",
                      "//",
                      "// O realm nao permite reusar um codigo (otpPolicyCodeReusable=false), entao esperamos o",
                      "// inicio da proxima janela de 30s antes de gerar. Assim duas execucoes seguidas do newman",
                      "// nunca mandam o mesmo codigo para a mesma credencial.",
                      "// CryptoJS ja existe como global no sandbox do Postman; o require e so para deixar explicito.",
                      "const cryptoJs = require(\"crypto-js\");",
                      "",
                      "function totp(secret, counter) {",
                      "    const key = cryptoJs.enc.Utf8.parse(secret);",
                      "    const high = Math.floor(counter / 0x100000000);",
                      "    const low = counter >>> 0;",
                      "    const message = cryptoJs.lib.WordArray.create([high, low], 8);",
                      "    const words = cryptoJs.HmacSHA1(message, key).words;",
                      "",
                      "    const bytes = [];",
                      "    for (let i = 0; i < 20; i++) {",
                      "        bytes.push((words[i >>> 2] >>> (24 - (i % 4) * 8)) & 0xff);",
                      "    }",
                      "",
                      "    const offset = bytes[19] & 0x0f;",
                      "    const binary = ((bytes[offset] & 0x7f) << 24)",
                      "        | ((bytes[offset + 1] & 0xff) << 16)",
                      "        | ((bytes[offset + 2] & 0xff) << 8)",
                      "        | (bytes[offset + 3] & 0xff);",
                      "",
                      "    return String(binary % 1000000).padStart(6, \"0\");",
                      "}",
                      "",
                      "const waitMs = 30000 - (Date.now() % 30000) + 500;",
                      "",
                      "return new Promise((resolve) => setTimeout(() => {",
                      "    const code = totp(pm.environment.get(\"totpSecret\"), Math.floor(Date.now() / 1000 / 30));",
                      "    pm.environment.set(\"totpCode\", code);",
                      "    console.log(\"janela TOTP \" + Math.floor(Date.now() / 1000 / 30) + \", codigo \" + code);",
                      "    resolve();",
                      "}, waitMs));"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"token emitido\", () => pm.response.to.have.status(200));",
                      "const body = pm.response.json();",
                      "pm.expect(body.access_token, \"access_token\").to.be.a(\"string\");",
                      "pm.environment.set(\"accessToken\", body.access_token);"
                    ]
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "key": "client_id",
                      "value": "{{clientId}}",
                      "type": "text"
                    },
                    {
                      "key": "grant_type",
                      "value": "password",
                      "type": "text"
                    },
                    {
                      "key": "username",
                      "value": "{{customer2faUser}}",
                      "type": "text"
                    },
                    {
                      "key": "password",
                      "value": "{{customer2faPass}}",
                      "type": "text"
                    },
                    {
                      "key": "totp",
                      "value": "{{totpCode}}",
                      "type": "text"
                    }
                  ]
                },
                "url": {
                  "raw": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
                  "host": [
                    "{{keycloakUrl}}"
                  ],
                  "path": [
                    "realms",
                    "{{realm}}",
                    "protocol",
                    "openid-connect",
                    "token"
                  ]
                },
                "description": "O pre-request gera o codigo de 6 digitos a partir do secret do autenticador."
              }
